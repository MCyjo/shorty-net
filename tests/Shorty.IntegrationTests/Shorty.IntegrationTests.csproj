<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Testcontainers.Azurite" Version="4.16.0" />
    <PackageReference Include="Testcontainers.EventHubs" Version="4.16.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shorty.Api\Shorty.Api.csproj" />
    <ProjectReference Include="..\..\src\Shorty.Core\Shorty.Core.csproj" />
    <!-- Both applications define a global Program class; the alias keeps the worker's out of the way (extern alias analytics). -->
    <ProjectReference Include="..\..\src\Shorty.Analytics\Shorty.Analytics.csproj" Aliases="analytics" />
  </ItemGroup>

</Project>