root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,json,yml,yaml,tf,hcl,xml,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Generated by EF Core: do not reformat.
[**/Migrations/*.cs]
generated_code = true
[*.Designer.cs]
generated_code = true
